{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "go",
      "runtimeArgs": ["-C", "backend", "run", "./cmd/devserver"],
      "port": 8788
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@strata/web", "dev"],
      "port": 5173
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8790", "-d", "site"],
      "port": 8790
    }
  ]
}
